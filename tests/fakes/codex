#!/usr/bin/env python3
"""Fake vendor CLI for tests (tests/fakes/agy is a symlink to this file).

Env:
  XV_FAKE_FIXTURE   jsonl file to print to stdout, line by line (unset: print nothing)
  XV_FAKE_RC        exit code (default 0)
  XV_FAKE_DELAY     seconds to sleep before each line (default 0)
  XV_FAKE_ARGV_OUT  if set, write sys.argv[1:] as JSON to this file
SIGTERM exits with rc 143.
"""
import json
import os
import signal
import sys
import time

signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))

if out := os.environ.get("XV_FAKE_ARGV_OUT"):
    with open(out, "w", encoding="utf-8") as f:
        json.dump(sys.argv[1:], f)

delay = float(os.environ.get("XV_FAKE_DELAY", "0"))
if fixture := os.environ.get("XV_FAKE_FIXTURE"):
    with open(fixture, encoding="utf-8") as f:
        for line in f:
            time.sleep(delay)
            sys.stdout.write(line)
            sys.stdout.flush()

sys.exit(int(os.environ.get("XV_FAKE_RC", "0")))
